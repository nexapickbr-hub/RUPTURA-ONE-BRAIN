      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        90
      ]
    },
    {
      "parameters": {
        "jsCode": "const d=$json; const prompt=`Crie um pacote ORIGINAL de vídeo curto em pt-BR. Retorne SOMENTE JSON válido com titulo,gancho,roteiro,legenda,cta,hashtags,ideia_visual,duracao_segundos,disclaimer. Tema: ${d.tema_base}. Objetivo: ${d.brief.objetivo}. Não invente fatos, não prometa renda, não incentive fraude e não copie terceiros.`; return [{json:{...d,ia_prompt:prompt}}];"
      },
      "id": "aa7eddaf-1bae-419b-9303-083de6f811c3",
      "name": "05 — PREPARAR IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        90
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$credentials.openAiApi.apiKey}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({model:'gpt-5.4-mini',input:$json.ia_prompt,max_output_tokens:1400})}}",
        "options": {
          "timeout": 120000,
          "retryOnFail": true,
          "maxAttempts": 3,
          "waitBetweenAttempts": 5000
        }
      },
      "id": "7da89b5f-e5c5-4c21-9bac-cb424f4181a0",
      "name": "06 — IA — OPENAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        880,
        90
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const d=$json; let text=d.output_text||''; if(!text&&Array.isArray(d.output)) for(const o of d.output) for(const c of (o.content||[])) if(typeof c.text==='string') text+=c.text; text=(text||'').trim().replace(/^```json\\s*/i,'').replace(/^```/,'').replace(/```$/,'').trim(); try{return [{json:{...d,...JSON.parse(text),status:'IA_OK'}}]}catch(e){return [{json:{...d,status:'ERRO_IA_JSON',erro:e.message,raw_ia:text.slice(0,4000)}}]}"
      },
      "id": "fab80c77-83ee-4b3d-9010-c0218a6dfc62",
      "name": "07 — INTERPRETAR IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        90
      ]
    },
    {
      "parameters": {
        "jsCode": "const d=$json,erros=[]; for(const k of ['titulo','gancho','roteiro','legenda','cta','ideia_visual']) if(typeof d[k]!=='string'||!d[k].trim()) erros.push(k); if(!Array.isArray(d.hashtags)||d.hashtags.length<2) erros.push('hashtags'); if(!Number.isInteger(d.duracao_segundos)||d.duracao_segundos<10||d.duracao_segundos>180) erros.push('duracao'); if((d.gancho||'').length<15) erros.push('gancho'); if((d.roteiro||'').length<180) erros.push('roteiro'); return [{json:{...d,qa_conteudo:!erros.length,qa_erros:erros,status:erros.length?'BLOQUEADO_QA':'QA_OK'}}];"
      },
      "id": "eebae183-0da6-4389-beff-e1229f8a42ab",
