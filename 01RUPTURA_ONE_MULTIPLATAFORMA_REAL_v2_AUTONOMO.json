    {
      "parameters": {
        "jsCode": "const d=$json; return [{json:{...d,brief:{objetivo:'alcance + monetização legítima',publico:'público consumidor',angulo:'gancho forte + valor + prova + CTA',restricoes:['não inventar fatos','não prometer ganhos','não fazer spam','não infringir direitos autorais','respeitar políticas de cada plataforma']}}}];"
