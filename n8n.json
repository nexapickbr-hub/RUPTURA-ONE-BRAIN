      "parameters": {
        "jsCode": "const b=$json.body??$json;\nif(!b||typeof b!=='object'||Array.isArray(b)) return [{json:{valid:false,error:'O corpo precisa ser um objeto JSON.',command:''}}];\nconst c=[b.message,b.command,b.prompt,b.text].find(v=>typeof v==='string'&&v.trim());\nif(!c) return [{json:{valid:false,error:'Envie message, command, prompt ou text.',command:''}}];\nreturn [{json:{valid:true,command:c.trim(),receivedAt:new Date().toISOString()}}];"
      },
