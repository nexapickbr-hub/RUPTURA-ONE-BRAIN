        "text": "={{ $json.command }}",
        "messages": {
          "messageValues": [
            {
              "message": "Você é o núcleo de interpretação do RUPTURA ONE.\nResponda em português do Brasil.\nNunca invente que uma ação foi executada, dados, credenciais ou resultados.\nNão execute ações; apenas interprete o comando.\nPara publicação, exclusão, envio ou ação irreversível, requires_confirmation=true.\nRetorne SOMENTE JSON válido neste formato:\n{\"intent\":\"research|script|content|video|qa|publish|analytics|system|unknown\",\"action\":\"\",\"parameters\":{},\"requires_confirmation\":false,\"missing_information\":[],\"reply\":\"\"}"
            },
            {
              "type": "HumanMessagePromptTemplate",
              "message": "={{ $json.command }}"
            }
          ]
        },
        "batching": {}
      },
