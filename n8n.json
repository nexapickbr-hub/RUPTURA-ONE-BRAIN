    },
    {
      "parameters": {
        "jsCode": "const raw=String($json.text??$json.response??'').trim();\nconst clean=raw.replace(/^```json\\s*/i,'').replace(/^```\\s*/i,'').replace(/\\s*```$/i,'').trim();\ntry{return [{json:{ok:true,...JSON.parse(clean),raw_model_output:raw}}]}\ncatch(e){return [{json:{ok:false,intent:'unknown',action:'',parameters:{},requires_confirmation:false,missing_information:[],reply:raw||'A IA não retornou resposta.',parse_error:true,error:'A resposta da IA não veio em JSON válido.',raw_model_output:raw}}]}"
      },
