      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst raw = body.message ?? body.command ?? body.prompt ?? body.text ?? '';\n\nif (typeof raw !== 'string' || !raw.trim()) {\n  return [{json:{\n    ok:false,\n    error:'COMMAND_REQUIRED',\n    message:'Envie um comando no campo message, command, prompt ou text.'\n  }}];\n}\n\nreturn [{json:{\n  ok:true,\n  request_id: body.request_id ?? `rup-${Date.now()}-${Math.random().toString(36).slice(2,8)}`,\n  command: raw.trim(),\n  source: body.source ?? 'webhook',\n  received_at: new Date().toISOString()\n}}];"
      },
      "id": "1ab9092e-0e63-4c3b-b41e-29e743493773",
