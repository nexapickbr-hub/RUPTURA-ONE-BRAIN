def code_node(node_id, name, x, y, js):
    return {
        "parameters": {
            "jsCode": js
        },
        "id": node_id,
        "name": name,
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [x, y]
    }

